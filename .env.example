# Copy this file to .env and fill in real values. Never commit the real .env file.
# .env is already listed in .gitignore.

# --- gluetun (VPN) ---
WIREGUARD_PRIVATE_KEY=
WIREGUARD_PUBLIC_KEY=
WIREGUARD_ADDRESSES=

# --- Watchtower email notifications ---
WATCHTOWER_EMAIL_FROM=
WATCHTOWER_EMAIL_TO=
WATCHTOWER_EMAIL_APP_PASSWORD=

# --- Cloudflare Tunnel ---
CLOUDFLARE_TUNNEL_TOKEN=

# --- Grafana (monitoring stack, LXC 104) ---
# Only read on Grafana's first start, when its database is created.
GRAFANA_ADMIN_PASSWORD=
